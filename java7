
<!DOCTYPE html>
<html>
<head>
    <title>Background Color</title>
<style>
body {
transition: 0.5s;
}</style>
</head>
<body>
<h1>Dynamic Background Color</h1>
<script>
let colors = ["pink", "yellow", "red", "orange", "navy"];
let i = 0;
function changeColor() {
document.body.style.backgroundColor = colors[i];
i = (i + 1) % colors.length;
}

changeColor();
setInterval(changeColor, 5000);
    </script>

</body>
</html>






































<!DOCTYPE html>
<html>
<head>
    <title>Email and Password Validation</title>
</head>
<body>
<h2>Login Form</h2>
<form onsubmit="return validate()">
Email:
<input type="text" id="email" required>
<br><br>
Password:
<input type="password" id="password" required>
<br><br>
<input type="submit" value="Login">
</form>
 <script>
function validate() {
let email = document.getElementById("email").value;
let pswd = document.getElementById("password").value;
if (!email.includes("@") || !email.includes(".")) {
alert("Email must contain @ and .");
return false;
}
if (!/[A-Za-z]/.test(pswd) || !/[0-9]/.test(pswd)) {
alert("Password must contain letters and numbers.");
return false;
}
alert("Login successful!");
return true;
}
    </script>
</body>
</html>
